# ─── Required ───────────────────────────────────────────────────────────────
# AI API key for slip analysis and chat. Get one free at https://console.groq.com
GROQ_API_KEY=replace_with_your_groq_api_key

# ─── Bot Identity ────────────────────────────────────────────────────────────
NODE_ENV=production

# Comma-separated WhatsApp numbers that receive admin alerts (country code, no +)
# Example: ADMIN_IDS=94771234567,94712345678
ADMIN_IDS=

# To use pairing code instead of QR scan, set your number here (digits only, no +)
PAIRING_PHONE_NUMBER=

# ─── Storage ─────────────────────────────────────────────────────────────────
SESSION_DIR=./session
DATABASE_FILE=./data/bot.sqlite

# ─── 1xBet Links ─────────────────────────────────────────────────────────────
XBET_LINK=https://1xbet.com
XBET_PROMO_CODE=VGSL
CHANNEL_LINK=https://t.me/fast_xbet_cash

# ─── Deposit / Withdrawal Limits (LKR) ───────────────────────────────────────
MIN_DEPOSIT_LKR=500
MAX_DEPOSIT_LKR=500000
MIN_WITHDRAW_LKR=1000
MAX_WITHDRAW_LKR=200000

# ─── Flow Timeouts (milliseconds) ────────────────────────────────────────────
# How long user has to pick a bank before the flow expires
SELECT_BANK_TIMEOUT_MS=120000
# How long user has to send a deposit slip after selecting bank (10 min)
AWAITING_SLIP_TIMEOUT_MS=600000
# How long user has to send their 1xBet ID (5 min)
AWAITING_ID_TIMEOUT_MS=300000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max messages allowed per user within the window
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_MS=60000

# ─── AI Models ───────────────────────────────────────────────────────────────
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
